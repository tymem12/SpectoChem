{
   "dataset": {
      "name": "TMQM_SPECTO",
      "root_dir": "data/datasets/TMQM_SPECTO",
      "in_channels": 1,
      "out_channels": 1,
      "task_type": "binary",
      "main_metric": "F1",
      "metric_mode": "max",
      "pre_transforms": {},
      "transforms": {
         "AddEdgesAndDistances": {
            "cutoff": 5.0
         }
      },
      "split_ratios": [
         0.8,
         0.1
      ],
      "additional_loading_params": {
         "prediction_type": "binary_classification",
         "num_states": 1,
         "vis_range": [
            380,
            650
         ],
         "block_3_only": true,
         "filter_type": "all_samples",
         "filter_f_value": -1,
         "min_f_value": 0.001,
         "sort_by_max_f": false,
         "standarize_lambda": false,
         "standarize_f": false
      },
      "target_standarization": null
   },
   "backbone": {
      "gnn_cls": "gjepa.models.backbones.UMAEncoder",
      "predictor_name": "uma-s-1p1"
   },
   "pos_encoding": null,
   "batch_size": 1,
   "output_dir": "data/precomputed_embeddings",
   "pool": "mean",
   "output_model_subdir": null
}